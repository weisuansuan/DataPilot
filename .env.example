# Copy to .env and set only credentials you explicitly intend to use.
# Local development is safe without a database or model configured.
DATAPILOT_LLM_ENABLED=false
DATAPILOT_LLM_API_KEY=
DATAPILOT_LLM_BASE_URL=https://api.deepseek.com
DATAPILOT_LLM_MODEL=deepseek-flash
DATAPILOT_DB_HOST=127.0.0.1
DATAPILOT_DB_PORT=3307
DATAPILOT_DB_NAME=datapilot
DATAPILOT_DB_READ_USER=datapilot_reader
DATAPILOT_DB_READ_PASSWORD=
DATAPILOT_DB_SEED_USER=datapilot_seed
DATAPILOT_DB_SEED_PASSWORD=
DATAPILOT_DB_ROOT_PASSWORD=
DATAPILOT_SEED_ORDER_COUNT=100000

# Copy to .env and set only credentials you explicitly intend to use.
# Local development is safe without a database or model configured.
DATAPILOT_AI_PROVIDER=qiniu
DATAPILOT_AI_BASE_URL=https://api.qnaigc.com/v1
DATAPILOT_AI_MODEL=qiniu/conatus-free
DATAPILOT_AI_STREAM=true
DATAPILOT_AI_TIMEOUT_SECONDS=45
DATAPILOT_AI_MAX_OUTPUT_TOKENS=1200
DATAPILOT_AI_MAX_REPAIR_ATTEMPTS=2
DATAPILOT_AI_LOCAL_BASE_URL=http://127.0.0.1:31415/v1
DATAPILOT_AI_LOCAL_MODEL=auto
DATAPILOT_AI_LOCAL_STREAM=false
DATAPILOT_AI_MODELSCOPE_BASE_URL=https://api-inference.modelscope.cn/v1
DATAPILOT_AI_MODELSCOPE_MODEL=moonshotai/Kimi-K3.1-Pro
DATAPILOT_AI_MODELSCOPE_STREAM=true
# Keep QINIU_API_KEY in the Windows user/system environment; this template is not imported as a model secret.
# Set DATAPILOT_AI_LOCAL_API_KEY only in the backend process environment; do not add it to this template.
# Set DATAPILOT_AI_MODELSCOPE_API_KEY only in the backend process environment; do not add it to this template.
DATAPILOT_DB_HOST=127.0.0.1
DATAPILOT_DB_PORT=3307
DATAPILOT_DB_NAME=datapilot
DATAPILOT_DB_READ_USER=datapilot_reader
DATAPILOT_DB_READ_PASSWORD=
DATAPILOT_DB_SEED_USER=datapilot_seed
DATAPILOT_DB_SEED_PASSWORD=
DATAPILOT_DB_ROOT_PASSWORD=
DATAPILOT_SEED_ORDER_COUNT=100000
